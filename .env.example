NETSCOPE_HOST=0.0.0.0
NETSCOPE_PORT=8000
NETSCOPE_CORS_ORIGINS=http://localhost:5173
NETSCOPE_DEFAULT_INTERFACE=
NETSCOPE_PACKET_BUFFER_SIZE=20000
NETSCOPE_QUEUE_SIZE=50000
NETSCOPE_BROADCAST_INTERVAL_MS=250
NETSCOPE_STATS_WINDOW_SECONDS=300
NETSCOPE_DATABASE_URL=sqlite+aiosqlite:///./netscope.db
NETSCOPE_GEOIP_DB_PATH=
NETSCOPE_ENABLE_REVERSE_DNS=true
NETSCOPE_LOG_LEVEL=INFO
NETSCOPE_DETECTOR_PORT_SCAN_THRESHOLD=3
NETSCOPE_DETECTOR_SYN_FLOOD_THRESHOLD=20
NETSCOPE_DETECTOR_ARP_SPOOF_THRESHOLD=2
NETSCOPE_DETECTOR_ICMP_FLOOD_THRESHOLD=15
NETSCOPE_DETECTOR_DNS_TUNNEL_THRESHOLD=0.7
